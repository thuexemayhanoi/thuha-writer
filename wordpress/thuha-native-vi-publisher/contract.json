{
  "auth": {
    "browser_origin": "refused unless listed in option thuha_adapter_allowed_origins",
    "capabilities": {
      "read": "edit_posts",
      "write": "publish_posts"
    },
    "cookie_sessions": "refused",
    "credential": "WordPress Application Password only"
  },
  "contract": "thuha-writer/1",
  "create_fields": [
    "contract",
    "idempotency_key",
    "topic_id",
    "language",
    "slug",
    "title",
    "content",
    "category_id",
    "featured_media",
    "seo",
    "marker"
  ],
  "definitive_rejections_before_insert": [
    "thuha_schema",
    "thuha_language_mismatch",
    "thuha_marker",
    "thuha_unsafe_html",
    "thuha_key_payload_mismatch",
    "thuha_topic_already_created",
    "thuha_category_language_mismatch",
    "thuha_media_invalid",
    "thuha_slug_conflict",
    "thuha_insert_failed",
    "thuha_native_vi_missing",
    "thuha_unauthenticated",
    "thuha_app_password_required",
    "thuha_origin_forbidden",
    "thuha_forbidden"
  ],
  "error_codes": [
    "thuha_unauthenticated",
    "thuha_app_password_required",
    "thuha_origin_forbidden",
    "thuha_forbidden",
    "thuha_schema",
    "thuha_language_mismatch",
    "thuha_marker",
    "thuha_unsafe_html",
    "thuha_key_payload_mismatch",
    "thuha_topic_already_created",
    "thuha_category_language_mismatch",
    "thuha_media_invalid",
    "thuha_slug_conflict",
    "thuha_insert_failed",
    "thuha_content_altered",
    "thuha_language_marker_failed",
    "thuha_seo_failed",
    "thuha_media_failed",
    "thuha_category_failed",
    "thuha_slug_changed",
    "thuha_permalink_mismatch",
    "thuha_publish_failed",
    "thuha_revert_failed",
    "thuha_in_progress",
    "thuha_duplicate_key",
    "thuha_foreign_post",
    "thuha_inventory_filtered",
    "thuha_native_vi_missing"
  ],
  "html_policy": {
    "attribute_values": {
      "loading": [
        "eager",
        "lazy"
      ],
      "target": [
        "_blank",
        "_self"
      ]
    },
    "attributes": {
      "a": [
        "href",
        "hreflang",
        "rel",
        "target"
      ],
      "blockquote": [
        "cite"
      ],
      "img": [
        "alt",
        "height",
        "loading",
        "src",
        "width"
      ],
      "ol": [
        "start",
        "type"
      ],
      "td": [
        "colspan",
        "rowspan",
        "scope"
      ],
      "th": [
        "colspan",
        "rowspan",
        "scope"
      ],
      "time": [
        "datetime"
      ]
    },
    "global_attributes": [
      "class",
      "dir",
      "id",
      "lang",
      "title"
    ],
    "tags": [
      "a",
      "abbr",
      "b",
      "blockquote",
      "br",
      "caption",
      "cite",
      "code",
      "div",
      "em",
      "figcaption",
      "figure",
      "h2",
      "h3",
      "h4",
      "h5",
      "h6",
      "hr",
      "i",
      "img",
      "li",
      "mark",
      "ol",
      "p",
      "pre",
      "small",
      "span",
      "strong",
      "sub",
      "sup",
      "table",
      "tbody",
      "td",
      "tfoot",
      "th",
      "thead",
      "time",
      "tr",
      "ul"
    ],
    "url_attributes": [
      "cite",
      "href",
      "src"
    ],
    "url_schemes": [
      "http",
      "https",
      "mailto",
      "tel"
    ],
    "void_tags": [
      "br",
      "hr",
      "img"
    ]
  },
  "limits": {
    "content_bytes": 200000,
    "seo_bytes": 400,
    "slug_bytes": 90,
    "title_bytes": 300
  },
  "live_status": "NOT_DEPLOYED_NOT_TESTED_AGAINST_WORDPRESS",
  "namespace": "thuha-writer/v1",
  "plugin": {
    "requires_native_plugin": "rentbikehanoi-native-vi (class RBHVI_Language, taxonomy rbhvi_language)",
    "slug": "thuha-native-vi-publisher",
    "version": "1.0.0"
  },
  "routes": {
    "categories": [
      "GET",
      "/categories"
    ],
    "create": [
      "POST",
      "/posts"
    ],
    "inventory": [
      "GET",
      "/inventory"
    ],
    "preflight": [
      "GET",
      "/preflight"
    ],
    "reconcile": [
      "GET",
      "/posts/by-key/(?P<key>[a-f0-9]{64})"
    ]
  },
  "safety": {
    "create_only": true,
    "draft_before_publish": true,
    "html_policy": "strict canonical form, shared with QA",
    "language_marker_before_publish": true,
    "permalink_checked_before_publish": true,
    "public_routes": 0,
    "raw_sql": false,
    "replay_mutates": false,
    "request_supplied_code": false
  },
  "seo_fields": [
    "title",
    "description",
    "focus_keyword"
  ],
  "site": "https://rentbikehanoi.com",
  "yoast_meta": [
    "_yoast_wpseo_title",
    "_yoast_wpseo_metadesc",
    "_yoast_wpseo_focuskw"
  ]
}
